#!/usr/bin/env bash
# subagent-telemetry — opt-in SubagentStop capture for superpipelines.
#
# SHIPS DISABLED. Not registered in hooks/hooks.json. The user opts in by
# registering it (see hooks/README-telemetry.md). Rationale: the orchestrator
# model cannot see per-subagent token counts (anthropics/claude-code #21837,
# #22625), so the only capture path is a hook reading ~/.claude/agent-metrics.jsonl.
#
# Contract: on SubagentStop, append ONE JSON line to
#   <run-dir>/run-telemetry.jsonl
# Never fail the run: any error -> write nothing, exit 0.
#
# Invoked via the polyglot wrapper:  run-hook.cmd subagent-telemetry
# Reads the hook event JSON on stdin.

# Buffer stdin (the hook event JSON) into an env var. It MUST be passed via the
# environment, not a pipe: the heredoc below already occupies python's stdin with
# the program text, so a piped stdin would never reach the script (read == EOF).
SP_HOOK_EVENT="$(cat 2>/dev/null || true)"
export SP_HOOK_EVENT

# python3 is the proven-available tool in-run (used for state hashing/merges);
# do all JSON work there, BOM-free, and swallow every error to exit 0.
python3 - <<'PY' 2>/dev/null || exit 0
import json, os, sys, glob, time

def jload(path):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return None

try:
    raw = os.environ.get("SP_HOOK_EVENT", "")
    event = json.loads(raw) if raw.strip() else {}
except Exception:
    sys.exit(0)

# Locate the active pipeline run dir. Prefer the explicit env var; else derive
# from a SUPERPIPELINES_RUN_DIR-style marker. Absent -> no-op (not in a run).
run_dir = os.environ.get("SUPERPIPELINES_RUN_DIR", "").strip()
if not run_dir or not os.path.isdir(run_dir):
    sys.exit(0)  # outside a pipeline run — nothing to capture

# Best-effort token/metrics lookup from ~/.claude/agent-metrics.jsonl.
# Match the most recent record for this session/agent when possible.
metrics = {}
session_id = event.get("session_id") or event.get("sessionId")
agent_id = event.get("agent_id") or event.get("agentId")
mpath = os.path.expanduser("~/.claude/agent-metrics.jsonl")
try:
    if os.path.isfile(mpath):
        with open(mpath, encoding="utf-8") as f:
            lines = [l for l in f if l.strip()]
        for line in reversed(lines):  # newest last -> scan from end
            try:
                rec = json.loads(line)
            except Exception:
                continue
            if agent_id and rec.get("agent_id") not in (agent_id, None) and rec.get("agentId") not in (agent_id, None):
                continue
            if session_id and rec.get("session_id") not in (session_id, None) and rec.get("sessionId") not in (session_id, None):
                continue
            metrics = rec
            break
except Exception:
    metrics = {}

# ctx_size ~ cumulative transcript tokens at the step boundary, when derivable.
ctx_size = metrics.get("ctx_size") or metrics.get("context_tokens")

row = {
    "ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    "step_id": event.get("step_id") or os.environ.get("SUPERPIPELINES_STEP_ID"),
    "agent": event.get("agent_type") or event.get("agentType"),
    "model": metrics.get("model"),
    "input_tok": metrics.get("input_tokens"),
    "output_tok": metrics.get("output_tokens"),
    "cache_read": metrics.get("cache_read_input_tokens") or metrics.get("cache_read"),
    "cache_creation": metrics.get("cache_creation_input_tokens") or metrics.get("cache_creation"),
    "ctx_size": ctx_size,
    "duration_ms": metrics.get("duration_ms"),
    "status": event.get("status"),
}

out = os.path.join(run_dir, "run-telemetry.jsonl")
try:
    # Append one BOM-free JSON line. open("a") is atomic enough for single-line
    # appends on both Win32 and POSIX for this low-frequency, best-effort log.
    with open(out, "a", encoding="utf-8") as f:
        f.write(json.dumps(row) + "\n")
except Exception:
    sys.exit(0)

sys.exit(0)
PY

# Belt-and-suspenders: never propagate a failure to the run.
exit 0
